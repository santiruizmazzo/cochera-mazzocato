{
  "name": "cochera-frontend",
  "version": "0.0.1",
  "description": "Frontend de Cochera Mazzocato",
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun run server.js",
    "build": "rm -rf ./build && bun build ./public/index.html --outdir ./build --env 'PUBLIC_*' --minify",
    "test": "bun test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "17.2.1"
  },
  "devDependencies": {
    "eslint": "9.33.0",
    "prettier": "3.6.2"
  }
}
